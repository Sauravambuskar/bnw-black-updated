# Config for scripts/sync-supabase-to-mysql.mjs
#
# Copy to .env.sync and fill in. .env.sync is gitignored - never commit real values.
#   cp .env.sync.example .env.sync
#
# Load it before running the sync, e.g.:
#   set -a && . ./.env.sync && set +a && npm run sync:mysql

# --- Supabase (source of truth) ---
